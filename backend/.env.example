DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fantasy_cricket?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fantasy_cricket?schema=public"
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="replace-this-with-at-least-32-random-characters"
JWT_EXPIRES_IN="7d"
AUTH_COOKIE_NAME="fantasy_cricket_session"
LOG_LEVEL="info"
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
