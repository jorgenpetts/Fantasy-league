# Copy this file to .env for Docker Compose local production testing.
POSTGRES_DB=fantasy_cricket
POSTGRES_USER=fantasy
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5433

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=fantasy_cricket_session
COOKIE_SECURE=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
FRONTEND_PORT=3000
BACKEND_PORT=4000
